{
  "name": "tactile",
  "devDependencies": {
    "@girs/adw-1": "1.4.2-3.2.7",
    "@girs/gdk-4.0": "4.0.0-3.2.7",
    "@girs/gio-2.0": "2.78.0-3.2.7",
    "@girs/gjs": "3.2.7",
    "@girs/gnome-shell": "45.0.0-beta8",
    "@girs/gtk-4.0": "4.12.4-3.2.7",
    "@girs/mtk-13": "13.0.0-3.2.7",
    "copyfiles": "2.4.1",
    "rimraf": "5.0.5",
    "typescript": "5.3"
  },
  "scripts": {
    "clean": "rimraf build",
    "compile-ts": "tsc --outDir build",
    "copy-styles": "copyup 'src/**/*.css' build",
    "copy-metadata": "copyup 'src/metadata.json' build",
    "copy-schemas": "copyup 'src/schemas/*.xml' build",
    "build": "npm run compile-ts && npm run copy-styles && npm run copy-metadata && npm run copy-schemas"
  }
}
