{
  "name": "tactile",
  "type": "module",
  "devDependencies": {
    "@girs/gnome-shell": "47.0.2",
    "@girs/mtk-13": "13.0.0-3.2.7",
    "prettier": "3.2",
    "typescript": "5.3"
  },
  "overrides": {
    "@girs/gio-2.0": "^2.82.4-4.0.0-beta.20"
  },
  "scripts": {
    "clean": "rm -rf build",
    "format": "prettier --write src",
    "check": "prettier --check src && glib-compile-schemas --strict --dry-run src/schemas",
    "build": "tsc --outDir build && cp -r src/metadata.json src/*.css src/schemas build"
  }
}